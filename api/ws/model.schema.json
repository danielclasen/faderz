{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/danielclasen/faderz/raw/main/api/ws/model.schema.json",
  "title": "faderz mixer model",
  "description": "Shared definitions for the faderz REST API and WebSocket messages: shape, live state, control paths, meters and counters.",
  "$defs": {
    "Id": {
      "description": "Identifier of a shape element (channel, bus, aux, mix-minus, VCA, monitor output, output, scene, console).",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "IdSet": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Id"
      },
      "uniqueItems": true
    },
    "ClientId": {
      "description": "Identifier of a client, generated by the client (a UUID for the web UI) and kept across reconnects and replica switches, or the id of a console surface. Touch ownership is keyed by it.",
      "type": "string",
      "pattern": "^[A-Za-z0-9:._-]{1,64}$"
    },
    "Revision": {
      "description": "Global revision of the replicated state, shared by all replicas. Every applied change set increments it by one.",
      "type": "integer",
      "minimum": 0
    },
    "CommandId": {
      "description": "Client-generated UUID of a command. A command id is applied at most once across all replicas, so a client may resend it after a failover.",
      "type": "string",
      "format": "uuid"
    },
    "SampleIndex": {
      "description": "Media-time sample index at which a change takes effect, chosen by the system so every replica applies it at the same sample.",
      "type": "integer",
      "minimum": 0
    },
    "ReplicaRole": {
      "description": "leader orders commands into the replicated state; followers serve clients and forward commands to the leader.",
      "type": "string",
      "enum": [
        "leader",
        "follower"
      ]
    },
    "ReplicaRef": {
      "description": "The replica that sent a message.",
      "type": "object",
      "required": [
        "id",
        "role"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "role": {
          "$ref": "#/$defs/ReplicaRole"
        }
      }
    },
    "ReplicaStatus": {
      "type": "object",
      "required": [
        "id",
        "role",
        "healthy"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "role": {
          "$ref": "#/$defs/ReplicaRole"
        },
        "healthy": {
          "type": "boolean"
        }
      }
    },
    "OwnershipChange": {
      "description": "A control was touched (owner set) or released (owner null).",
      "type": "object",
      "required": [
        "path",
        "owner"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "#/$defs/ControlPath"
        },
        "owner": {
          "oneOf": [
            {
              "$ref": "#/$defs/ClientId"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Layout": {
      "description": "Channel layout. Width: mono 1, stereo 2, 5.1 6, 7.1 8. Channel order: mono M; stereo L R; 5.1 L R C LFE Ls Rs; 7.1 L R C LFE Ls Rs Lrs Rrs.",
      "type": "string",
      "enum": [
        "mono",
        "stereo",
        "5.1",
        "7.1"
      ]
    },
    "Width": {
      "type": "integer",
      "enum": [
        1,
        2,
        6,
        8
      ]
    },
    "FaderDb": {
      "description": "Gain in dB. -90 is fully closed (-inf). Fader travel ends at +10 dB.",
      "type": "number",
      "minimum": -90,
      "maximum": 10
    },
    "TrimDb": {
      "type": "number",
      "minimum": -20,
      "maximum": 20
    },
    "Pan": {
      "description": "-1 is full left (or front), 0 centre, 1 full right (or rear).",
      "type": "number",
      "minimum": -1,
      "maximum": 1
    },
    "Solo": {
      "description": "Listen state of a channel on the monitor: pre-fader listen, after-fader listen (post-fader, before the AFV stage) or off.",
      "type": "string",
      "enum": [
        "off",
        "pfl",
        "afl"
      ]
    },
    "HpfFreq": {
      "description": "Hz",
      "type": "number",
      "minimum": 20,
      "maximum": 500
    },
    "EqFreq": {
      "description": "Hz",
      "type": "number",
      "minimum": 20,
      "maximum": 20000
    },
    "EqGain": {
      "description": "dB",
      "type": "number",
      "minimum": -18,
      "maximum": 18
    },
    "EqQ": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 16
    },
    "EqBandType": {
      "type": "string",
      "enum": [
        "lowShelf",
        "peak",
        "highShelf"
      ]
    },
    "GateThreshold": {
      "description": "dBFS",
      "type": "number",
      "minimum": -80,
      "maximum": 0
    },
    "GateRange": {
      "description": "Attenuation when closed, dB",
      "type": "number",
      "minimum": 0,
      "maximum": 80
    },
    "CompThreshold": {
      "description": "dBFS",
      "type": "number",
      "minimum": -60,
      "maximum": 0
    },
    "CompRatio": {
      "type": "number",
      "minimum": 1,
      "maximum": 20
    },
    "AttackMs": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 200
    },
    "ReleaseMs": {
      "type": "number",
      "minimum": 5,
      "maximum": 5000
    },
    "MakeupDb": {
      "type": "number",
      "minimum": 0,
      "maximum": 24
    },
    "DelaySamples": {
      "description": "Integer delay in samples at the shape sample rate.",
      "type": "integer",
      "minimum": 0,
      "maximum": 48000
    },
    "TallySource": {
      "description": "Name of a tally source as sent by the vision switcher.",
      "type": "string",
      "pattern": "^[A-Za-z0-9 ._:-]{1,64}$"
    },
    "TallyState": {
      "type": "string",
      "enum": [
        "program",
        "preview",
        "off"
      ]
    },
    "RecallGroup": {
      "description": "Parameter group protected from scene recall. input covers trim, polarity, HPF and delay; dynamics covers gate and compressor.",
      "type": "string",
      "enum": [
        "input",
        "eq",
        "dynamics",
        "pan",
        "sends",
        "routing",
        "fader",
        "mute",
        "afv"
      ]
    },
    "ChannelShape": {
      "type": "object",
      "required": [
        "id",
        "name",
        "width",
        "layout"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "width": {
          "$ref": "#/$defs/Width"
        },
        "layout": {
          "$ref": "#/$defs/Layout"
        }
      }
    },
    "BusShape": {
      "type": "object",
      "required": [
        "id",
        "name",
        "kind",
        "width",
        "layout"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "kind": {
          "type": "string",
          "enum": [
            "program",
            "me",
            "cleanFeed"
          ]
        },
        "width": {
          "$ref": "#/$defs/Width"
        },
        "layout": {
          "$ref": "#/$defs/Layout"
        }
      }
    },
    "MixMinusShape": {
      "description": "Bus `bus` summed without the channels in the live `exclude` set, taken before bus processing.",
      "type": "object",
      "required": [
        "id",
        "name",
        "bus",
        "width",
        "layout"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "bus": {
          "$ref": "#/$defs/Id"
        },
        "width": {
          "$ref": "#/$defs/Width"
        },
        "layout": {
          "$ref": "#/$defs/Layout"
        }
      }
    },
    "ElementShape": {
      "description": "Aux bus or monitor output.",
      "type": "object",
      "required": [
        "id",
        "name",
        "width",
        "layout"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "width": {
          "$ref": "#/$defs/Width"
        },
        "layout": {
          "$ref": "#/$defs/Layout"
        }
      }
    },
    "VcaShape": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        }
      }
    },
    "OutputShape": {
      "description": "Output flow carrying a bus, aux, mix-minus or monitor output.",
      "type": "object",
      "required": [
        "id",
        "name",
        "source",
        "width",
        "layout"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "source": {
          "$ref": "#/$defs/Id"
        },
        "width": {
          "$ref": "#/$defs/Width"
        },
        "layout": {
          "$ref": "#/$defs/Layout"
        }
      }
    },
    "Shape": {
      "description": "Mixer shape from start-up configuration. Fixed while the server runs.",
      "type": "object",
      "required": [
        "sampleRate",
        "channels",
        "buses",
        "auxes",
        "mixMinus",
        "vcas",
        "monitorOutputs",
        "outputs"
      ],
      "additionalProperties": false,
      "properties": {
        "sampleRate": {
          "type": "integer",
          "enum": [
            48000
          ]
        },
        "channels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChannelShape"
          }
        },
        "buses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BusShape"
          }
        },
        "auxes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ElementShape"
          }
        },
        "mixMinus": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MixMinusShape"
          }
        },
        "vcas": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VcaShape"
          }
        },
        "monitorOutputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ElementShape"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OutputShape"
          }
        }
      }
    },
    "Hpf": {
      "type": "object",
      "required": [
        "enabled",
        "freq"
      ],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "freq": {
          "$ref": "#/$defs/HpfFreq"
        }
      }
    },
    "EqBand": {
      "type": "object",
      "required": [
        "type",
        "freq",
        "gain",
        "q"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/$defs/EqBandType"
        },
        "freq": {
          "$ref": "#/$defs/EqFreq"
        },
        "gain": {
          "$ref": "#/$defs/EqGain"
        },
        "q": {
          "$ref": "#/$defs/EqQ"
        }
      }
    },
    "Eq": {
      "description": "4-band EQ. Bands are ordered low to high.",
      "type": "object",
      "required": [
        "enabled",
        "bands"
      ],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "bands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EqBand"
          },
          "minItems": 4,
          "maxItems": 4
        }
      }
    },
    "Gate": {
      "description": "Gate/expander. Linked across the channel width with a shared sidechain.",
      "type": "object",
      "required": [
        "enabled",
        "threshold",
        "range",
        "attack",
        "release"
      ],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "threshold": {
          "$ref": "#/$defs/GateThreshold"
        },
        "range": {
          "$ref": "#/$defs/GateRange"
        },
        "attack": {
          "$ref": "#/$defs/AttackMs"
        },
        "release": {
          "$ref": "#/$defs/ReleaseMs"
        }
      }
    },
    "Comp": {
      "description": "Compressor without look-ahead. Linked across the channel width with a shared sidechain.",
      "type": "object",
      "required": [
        "enabled",
        "threshold",
        "ratio",
        "attack",
        "release",
        "makeup"
      ],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "threshold": {
          "$ref": "#/$defs/CompThreshold"
        },
        "ratio": {
          "$ref": "#/$defs/CompRatio"
        },
        "attack": {
          "$ref": "#/$defs/AttackMs"
        },
        "release": {
          "$ref": "#/$defs/ReleaseMs"
        },
        "makeup": {
          "$ref": "#/$defs/MakeupDb"
        }
      }
    },
    "PanState": {
      "description": "lr is the left/right position; fr the front/rear position, used by the 5.1 panner on surround buses. Ignored for channels whose width equals the bus width.",
      "type": "object",
      "required": [
        "lr",
        "fr"
      ],
      "additionalProperties": false,
      "properties": {
        "lr": {
          "$ref": "#/$defs/Pan"
        },
        "fr": {
          "$ref": "#/$defs/Pan"
        }
      }
    },
    "Send": {
      "type": "object",
      "required": [
        "on",
        "level",
        "pan",
        "pre"
      ],
      "additionalProperties": false,
      "properties": {
        "on": {
          "type": "boolean"
        },
        "level": {
          "$ref": "#/$defs/FaderDb"
        },
        "pan": {
          "$ref": "#/$defs/Pan"
        },
        "pre": {
          "description": "true taps pre-fader, false post-fader.",
          "type": "boolean"
        }
      }
    },
    "ChannelState": {
      "type": "object",
      "required": [
        "trim",
        "polarity",
        "hpf",
        "eq",
        "gate",
        "comp",
        "delay",
        "pan",
        "fader",
        "mute",
        "solo",
        "sends",
        "routes"
      ],
      "additionalProperties": false,
      "properties": {
        "trim": {
          "$ref": "#/$defs/TrimDb"
        },
        "polarity": {
          "description": "true inverts the polarity of every channel of the strip.",
          "type": "boolean"
        },
        "hpf": {
          "$ref": "#/$defs/Hpf"
        },
        "eq": {
          "$ref": "#/$defs/Eq"
        },
        "gate": {
          "$ref": "#/$defs/Gate"
        },
        "comp": {
          "$ref": "#/$defs/Comp"
        },
        "delay": {
          "$ref": "#/$defs/DelaySamples"
        },
        "pan": {
          "$ref": "#/$defs/PanState"
        },
        "fader": {
          "$ref": "#/$defs/FaderDb"
        },
        "mute": {
          "type": "boolean"
        },
        "solo": {
          "$ref": "#/$defs/Solo"
        },
        "sends": {
          "description": "Sends keyed by aux id.",
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/Id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/Send"
          }
        },
        "routes": {
          "description": "Bus assignment keyed by bus id.",
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/Id"
          },
          "additionalProperties": {
            "type": "boolean"
          }
        }
      }
    },
    "BusState": {
      "description": "Bus processing: the channel strip without trim, HPF and pan. Used for buses and auxes.",
      "type": "object",
      "required": [
        "polarity",
        "eq",
        "gate",
        "comp",
        "delay",
        "fader",
        "mute"
      ],
      "additionalProperties": false,
      "properties": {
        "polarity": {
          "type": "boolean"
        },
        "eq": {
          "$ref": "#/$defs/Eq"
        },
        "gate": {
          "$ref": "#/$defs/Gate"
        },
        "comp": {
          "$ref": "#/$defs/Comp"
        },
        "delay": {
          "$ref": "#/$defs/DelaySamples"
        },
        "fader": {
          "$ref": "#/$defs/FaderDb"
        },
        "mute": {
          "type": "boolean"
        }
      }
    },
    "MixMinusState": {
      "type": "object",
      "required": [
        "exclude",
        "fader",
        "mute"
      ],
      "additionalProperties": false,
      "properties": {
        "exclude": {
          "description": "Channel ids left out of the sum.",
          "$ref": "#/$defs/IdSet"
        },
        "fader": {
          "$ref": "#/$defs/FaderDb"
        },
        "mute": {
          "type": "boolean"
        }
      }
    },
    "VcaState": {
      "description": "offset is added in dB to every member's fader; offsets of several memberships sum. Effective channel gain is clamped at +20 dB. mute mutes every member. Members' faders do not move.",
      "type": "object",
      "required": [
        "offset",
        "mute",
        "members"
      ],
      "additionalProperties": false,
      "properties": {
        "offset": {
          "$ref": "#/$defs/FaderDb"
        },
        "mute": {
          "type": "boolean"
        },
        "members": {
          "description": "Channel ids.",
          "$ref": "#/$defs/IdSet"
        }
      }
    },
    "MonitorState": {
      "description": "Monitor section. While any channel has solo pfl or afl, the monitor plays the listen sum instead of source.",
      "type": "object",
      "required": [
        "source",
        "level",
        "dim",
        "cut",
        "mono"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "description": "Bus, aux or mix-minus id.",
          "$ref": "#/$defs/Id"
        },
        "level": {
          "$ref": "#/$defs/FaderDb"
        },
        "dim": {
          "type": "boolean"
        },
        "cut": {
          "type": "boolean"
        },
        "mono": {
          "type": "boolean"
        }
      }
    },
    "AfvBinding": {
      "description": "Audio-follow-video stage of a channel: post-fader, ramped 0/1 gain. open is driven by tally and is read-only.",
      "type": "object",
      "required": [
        "enabled",
        "source",
        "open"
      ],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "source": {
          "oneOf": [
            {
              "$ref": "#/$defs/TallySource"
            },
            {
              "type": "null"
            }
          ]
        },
        "open": {
          "type": "boolean"
        }
      }
    },
    "Scene": {
      "type": "object",
      "required": [
        "id",
        "name",
        "storedAt"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "storedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ConsoleStatus": {
      "description": "Hardware control surface attached to the mixer.",
      "type": "object",
      "required": [
        "id",
        "name",
        "protocol",
        "transport",
        "connected",
        "bankOffset",
        "strips"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "protocol": {
          "type": "string",
          "enum": [
            "mcu",
            "hui",
            "osc"
          ]
        },
        "transport": {
          "type": "string",
          "enum": [
            "alsa-midi",
            "bridge",
            "osc-udp"
          ]
        },
        "connected": {
          "type": "boolean"
        },
        "bankOffset": {
          "description": "Index of the first channel on the surface.",
          "type": "integer",
          "minimum": 0
        },
        "strips": {
          "description": "Fader strips on the surface.",
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "State": {
      "description": "Live mixer state. Maps are keyed by the ids of the shape.",
      "type": "object",
      "required": [
        "channels",
        "buses",
        "auxes",
        "mixMinus",
        "vcas",
        "monitor",
        "afv",
        "tally",
        "recallSafe",
        "scenes",
        "consoles"
      ],
      "additionalProperties": false,
      "properties": {
        "channels": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/Id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/ChannelState"
          }
        },
        "buses": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/Id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/BusState"
          }
        },
        "auxes": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/Id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/BusState"
          }
        },
        "mixMinus": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/Id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/MixMinusState"
          }
        },
        "vcas": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/Id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/VcaState"
          }
        },
        "monitor": {
          "$ref": "#/$defs/MonitorState"
        },
        "afv": {
          "description": "AFV bindings keyed by channel id.",
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/Id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/AfvBinding"
          }
        },
        "tally": {
          "description": "Last tally state per source.",
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/TallySource"
          },
          "additionalProperties": {
            "$ref": "#/$defs/TallyState"
          }
        },
        "recallSafe": {
          "description": "Recall-safe parameter groups keyed by channel, bus, aux, mix-minus or VCA id. An absent id has none.",
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/Id"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/RecallGroup"
            },
            "uniqueItems": true
          }
        },
        "scenes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Scene"
          }
        },
        "consoles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConsoleStatus"
          }
        }
      }
    },
    "Owners": {
      "description": "Owned controls: control path to the owning client id. Part of the replicated state: ownership survives a replica switch, and is released 2 s after its client has no connection to any replica.",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/ControlPath"
      },
      "additionalProperties": {
        "$ref": "#/$defs/ClientId"
      }
    },
    "StateDocument": {
      "type": "object",
      "required": [
        "revision",
        "replica",
        "shape",
        "state",
        "owners"
      ],
      "additionalProperties": false,
      "properties": {
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "replica": {
          "$ref": "#/$defs/ReplicaRef"
        },
        "shape": {
          "$ref": "#/$defs/Shape"
        },
        "state": {
          "$ref": "#/$defs/State"
        },
        "owners": {
          "$ref": "#/$defs/Owners"
        }
      }
    },
    "ControlPath": {
      "description": "JSON Pointer (RFC 6901) to a writable leaf of State.",
      "type": "string",
      "anyOf": [
        {
          "pattern": "^/channels/[a-z][a-z0-9-]{0,31}/(trim|polarity|hpf/(enabled|freq)|eq/enabled|eq/bands/[0-3]/(type|freq|gain|q)|gate/(enabled|threshold|range|attack|release)|comp/(enabled|threshold|ratio|attack|release|makeup)|delay|pan/(lr|fr)|fader|mute|solo|sends/[a-z][a-z0-9-]{0,31}/(on|level|pan|pre)|routes/[a-z][a-z0-9-]{0,31})$"
        },
        {
          "pattern": "^/(buses|auxes)/[a-z][a-z0-9-]{0,31}/(polarity|eq/enabled|eq/bands/[0-3]/(type|freq|gain|q)|gate/(enabled|threshold|range|attack|release)|comp/(enabled|threshold|ratio|attack|release|makeup)|delay|fader|mute)$"
        },
        {
          "pattern": "^/mixMinus/[a-z][a-z0-9-]{0,31}/(exclude|fader|mute)$"
        },
        {
          "pattern": "^/vcas/[a-z][a-z0-9-]{0,31}/(offset|mute|members)$"
        },
        {
          "pattern": "^/monitor/(source|level|dim|cut|mono)$"
        },
        {
          "pattern": "^/afv/[a-z][a-z0-9-]{0,31}/(enabled|source)$"
        },
        {
          "pattern": "^/recallSafe/[a-z][a-z0-9-]{0,31}$"
        }
      ]
    },
    "ReadOnlyPath": {
      "description": "JSON Pointer to a part of State that only the server changes.",
      "type": "string",
      "anyOf": [
        {
          "pattern": "^/afv/[a-z][a-z0-9-]{0,31}/open$"
        },
        {
          "pattern": "^/tally/[A-Za-z0-9 ._:-]{1,64}$"
        },
        {
          "pattern": "^/(scenes|consoles)$"
        }
      ]
    },
    "ValueByPath": {
      "description": "Constrains `value` by the leaf `path` points to.",
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": {
              "path": {
                "type": "string",
                "pattern": "/(fader|level|offset)$"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/FaderDb"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "path": {
                "type": "string",
                "pattern": "/trim$"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/TrimDb"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "path": {
                "type": "string",
                "pattern": "(/(polarity|enabled|mute|on|pre|dim|cut|mono|open)|/routes/[a-z][a-z0-9-]{0,31})$"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "path": {
                "type": "string",
                "pattern": "/hpf/freq$"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/HpfFreq"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "path": {
                "type": "string",
                "pattern": "/bands/[0-3]/freq$"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/EqFreq"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "path": {
                "type": "string",
                "pattern": "/bands/[0-3]/gain$"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/EqGain"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "path": {
                "type": "string",
                "pattern": "/bands/[0-3]/q$"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/EqQ"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "path": {
                "type": "string",
                "pattern": "/bands/[0-3]/type$"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/EqBandType"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "path": {
                "type": "string",
                "pattern": "/gate/threshold$"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/GateThreshold"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "path": {
                "type": "string",
                "pattern": "/gate/range$"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/GateRange"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "path": {
                "type": "string",
                "pattern": "/comp/threshold$"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/CompThreshold"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "path": {
                "type": "string",
                "pattern": "/comp/ratio$"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/CompRatio"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "path": {
                "type": "string",
                "pattern": "/(gate|comp)/attack$"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/AttackMs"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "path": {
                "type": "string",
                "pattern": "/(gate|comp)/release$"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/ReleaseMs"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "path": {
                "type": "string",
                "pattern": "/comp/makeup$"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/MakeupDb"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "path": {
                "type": "string",
                "pattern": "/delay$"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/DelaySamples"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "path": {
                "type": "string",
                "pattern": "(/pan/(lr|fr)|/sends/[a-z][a-z0-9-]{0,31}/pan)$"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/Pan"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "path": {
                "type": "string",
                "pattern": "/solo$"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/Solo"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "path": {
                "type": "string",
                "pattern": "/(exclude|members)$"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/IdSet"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "path": {
                "const": "/monitor/source"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/Id"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^/afv/[a-z][a-z0-9-]{0,31}/source$"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/TallySource"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^/recallSafe/"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/RecallGroup"
                },
                "uniqueItems": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^/tally/"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/TallyState"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "path": {
                "const": "/scenes"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Scene"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "path": {
                "const": "/consoles"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/ConsoleStatus"
                }
              }
            }
          }
        }
      ]
    },
    "Change": {
      "description": "Write of one control.",
      "type": "object",
      "required": [
        "path",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "#/$defs/ControlPath"
        },
        "value": true
      },
      "$ref": "#/$defs/ValueByPath"
    },
    "StateChange": {
      "description": "One changed leaf of State, as carried by a delta.",
      "type": "object",
      "required": [
        "path",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "anyOf": [
            {
              "$ref": "#/$defs/ControlPath"
            },
            {
              "$ref": "#/$defs/ReadOnlyPath"
            }
          ]
        },
        "value": true
      },
      "$ref": "#/$defs/ValueByPath"
    },
    "Conflict": {
      "description": "A write refused because another client owns the control.",
      "type": "object",
      "required": [
        "path",
        "current",
        "owner"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "#/$defs/ControlPath"
        },
        "current": {
          "description": "Current value of the control."
        },
        "owner": {
          "$ref": "#/$defs/ClientId"
        }
      }
    },
    "MeterDb": {
      "description": "Level in dBFS (true peak in dBTP). -120 is silence or below.",
      "type": "number",
      "minimum": -120,
      "maximum": 30
    },
    "MeterLegs": {
      "description": "One value per channel of the element, in layout order.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/MeterDb"
      },
      "minItems": 1,
      "maxItems": 8
    },
    "ChannelMeter": {
      "description": "Input channel metering: sample peak and RMS.",
      "type": "object",
      "required": [
        "peak",
        "rms"
      ],
      "additionalProperties": false,
      "properties": {
        "peak": {
          "$ref": "#/$defs/MeterLegs"
        },
        "rms": {
          "$ref": "#/$defs/MeterLegs"
        }
      }
    },
    "Loudness": {
      "description": "ITU-R BS.1770-5 / EBU R128 loudness in LUFS, LRA in LU (EBU Tech 3342). null until enough audio has been measured. integratedValid is false after a telemetry drop until the integrated measurement is reset.",
      "type": "object",
      "required": [
        "momentary",
        "shortTerm",
        "integrated",
        "lra",
        "integratedValid"
      ],
      "additionalProperties": false,
      "properties": {
        "momentary": {
          "oneOf": [
            {
              "type": "number",
              "minimum": -120,
              "maximum": 30
            },
            {
              "type": "null"
            }
          ]
        },
        "shortTerm": {
          "oneOf": [
            {
              "type": "number",
              "minimum": -120,
              "maximum": 30
            },
            {
              "type": "null"
            }
          ]
        },
        "integrated": {
          "oneOf": [
            {
              "type": "number",
              "minimum": -120,
              "maximum": 30
            },
            {
              "type": "null"
            }
          ]
        },
        "lra": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "integratedValid": {
          "type": "boolean"
        }
      }
    },
    "BusMeter": {
      "description": "Bus, aux and mix-minus metering: sample peak, true peak (4x oversampling), RMS and loudness.",
      "type": "object",
      "required": [
        "peak",
        "truePeak",
        "rms",
        "loudness"
      ],
      "additionalProperties": false,
      "properties": {
        "peak": {
          "$ref": "#/$defs/MeterLegs"
        },
        "truePeak": {
          "$ref": "#/$defs/MeterLegs"
        },
        "rms": {
          "$ref": "#/$defs/MeterLegs"
        },
        "loudness": {
          "$ref": "#/$defs/Loudness"
        }
      }
    },
    "Counters": {
      "description": "Engine counters by metric name, as exported on /metrics.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*_total$"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    }
  }
}
